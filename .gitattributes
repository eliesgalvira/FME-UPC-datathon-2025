# Normalize text files to LF in the repo; Git converts on checkout if needed
* text=auto eol=lf

# Binary files (no CRLF conversion or diffs)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.zip  binary
*.gz   binary
*.bz2  binary
*.7z   binary
*.mp4  binary
*.mov  binary
*.mp3  binary
*.wav  binary
*.exe  binary
*.dll  binary

# Merge strategies for lock files (keep theirs or ours can be dangerous; prefer manual)
# Example: npm/yarn/pnpm lockfiles benefit from text merge + conflict resolution
package-lock.json  -merge
yarn.lock          -merge
pnpm-lock.yaml     -merge
bun.lock           -merge

